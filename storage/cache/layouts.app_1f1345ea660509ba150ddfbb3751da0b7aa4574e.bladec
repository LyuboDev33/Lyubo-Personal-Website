 <script src="https://unpkg.com/lenis@1.3.23/dist/lenis.min.js"></script>

 <script>
 const lenis = new Lenis({
 duration: 1,
 smoothWheel: true,
 wheelMultiplier: 0.8,
 touchMultiplier: 0.8,
 lerp: 0.5
 });

 function raf(time) {
 lenis.raf(time);
 requestAnimationFrame(raf);
 }

 requestAnimationFrame(raf);
 </script>

